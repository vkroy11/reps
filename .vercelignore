# What never needs to reach a web build.
#
# The CLI uploads the working directory, and `expo prebuild` leaves 4 GB of
# Gradle output in apps/mobile/android. Without this the upload aborts before a
# build ever starts. Git ignores these too, but .vercelignore takes precedence
# once it exists, so everything that matters has to be listed here.

node_modules
.git

# Native projects - regenerated by `expo prebuild`, and irrelevant to the web
# export.
apps/mobile/android
apps/mobile/ios

# Built locally; Vercel builds its own.
apps/mobile/dist
apps/api/dist
**/.expo

# apps/api itself stays: `npm ci` validates the lockfile against every
# workspace's package.json, so removing one breaks the install even though the
# API is deployed elsewhere.

# Local-only.
.env
.env.*
*.log
