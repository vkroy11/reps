{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // "node" is here for the source-audit test, which reads files off disk.
    // It brings Node globals into scope for app code too, which is why every
    // timer handle in this app is typed `ReturnType<typeof setTimeout>` rather
    // than `number` - that form is correct under both lib sets.
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      "@reps/core": ["../../packages/core/src"],
      "@reps/ui": ["../../packages/ui/src"],
      "@reps/client": ["../../packages/client/src"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "dist"]
}
