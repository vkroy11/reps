{
  "expo": {
    "name": "Reps",
    "slug": "reps",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": ["reps", "com.reps.app"],
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8FAFC",
    "ios": {
      "bundleIdentifier": "com.reps.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.reps.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundColor": "#2563EB"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/favicon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9481ccde-e9f7-4d35-9a00-c19d8c1b3ada",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": "production"
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC",
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 128
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2563EB"
        }
      ],
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9481ccde-e9f7-4d35-9a00-c19d8c1b3ada"
      },
      "googleOAuth": {
        "web": "853694041925-enuhkoen66o2f4nsvge1p3bh9j04il88.apps.googleusercontent.com",
        "ios": "",
        "android": "853694041925-mcaa3p2uva95qf6cn0rs1b5du0l9vobi.apps.googleusercontent.com"
      }
    }
  }
}
