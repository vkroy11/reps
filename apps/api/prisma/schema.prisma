// Vocabulary fields (archetype, modality, status, confidence, format) are
// stored as text rather than native enums on purpose: the domain vocabulary is
// defined once as Zod schemas in packages/core and validated at every
// boundary. Duplicating it here would create a second source of truth and a
// migration for every vocabulary change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A learner. Anonymous until they sign in, and still the same row afterwards.
model User {
  id        String   @id
  /// Set only once Google sign-in has happened. Null is the normal state.
  googleId  String?  @unique
  email     String?
  name      String?
  createdAt DateTime @default(now())

  devices  Device[]
  paths    LearningPath[]
  notes    Note[]
  sessions PracticeSession[]
  badges   Badge[]
}

/// Which user a device is currently speaking for.
///
/// A separate table rather than a column on User, because the relationship is
/// many-to-one and it *moves*: signing in on a second device re-points that
/// device's row at the account and carries its data across. With the device id
/// as a column on User, claiming would have meant deleting a user row - and
/// with it any row that still referenced it.
model Device {
  /// The client-generated id, so the client needs no server round-trip to have
  /// an identity.
  id        String   @id
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LearningPath {
  id               String   @id
  userId           String
  skill            String
  archetype        String
  goal             String
  level            String
  dailyMinutes     Int
  daysPerWeek      Int
  preferredFormats String[]
  language         String
  createdAt        DateTime
  updatedAt        DateTime @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  techniques Technique[]
  sessions   PracticeSession[]
  badges     Badge[]

  @@index([userId, createdAt])
}

model Technique {
  id     String @id
  pathId String
  /// "order" is a reserved word in SQL, so the column is named position.
  order  Int    @map("position")

  title                String
  whyItMatters         String
  modality             String
  practicePrompt       String
  estimatedMinutes     Int
  status               String
  confidence           String?
  struggleCount        Int      @default(0)
  bridgeForTechniqueId String?
  searchQueries        String[]

  path      LearningPath       @relation(fields: [pathId], references: [id], onDelete: Cascade)
  resources Resource[]
  content   TechniqueContent[]
  notes     Note[]
  sessions  PracticeSession[]

  @@index([pathId, order])
}

model Resource {
  id              String  @id
  techniqueId     String
  format          String
  title           String
  url             String?
  thumbnailUrl    String?
  source          String
  durationSec     Int?
  selectionReason String

  technique Technique @relation(fields: [techniqueId], references: [id], onDelete: Cascade)

  @@index([techniqueId])
}

/// Generated lessons, drills and card decks. Keyed by technique and format so
/// re-opening a technique costs nothing.
model TechniqueContent {
  techniqueId String
  format      String
  content     Json
  createdAt   DateTime @default(now())

  technique Technique @relation(fields: [techniqueId], references: [id], onDelete: Cascade)

  @@id([techniqueId, format])
}

/// Notes taken while practising. Deliberately keyed to a technique and,
/// optionally, to a timestamp inside one of its resources.
model Note {
  id           String   @id
  userId       String
  techniqueId  String
  resourceId   String?
  timestampSec Int?
  body         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  technique Technique @relation(fields: [techniqueId], references: [id], onDelete: Cascade)

  /// The notebook reads by user; the technique screen reads by technique.
  @@index([userId, createdAt])
  @@index([techniqueId, timestampSec])
}

/// Resource search results keyed by normalized query hash. This is what makes
/// YouTube's ~100 searches/day workable across users.
model ResourceCacheEntry {
  key        String   @id
  candidates Json
  cachedAt   DateTime @default(now())
}

/// Daily spend against an external provider's allowance.
model QuotaUsage {
  resource String
  /// Calendar day as YYYY-MM-DD.
  day      String
  units    Int    @default(0)

  @@id([resource, day])
}

/// One completed practice session.
///
/// Named for the practice rather than the XP because XP is only one thing it
/// records. It is also the source for the streak, the week strip and the
/// practice heatmap, and the sum of its minutes per technique is what the
/// board's mastery ring is drawn from.
model PracticeSession {
  id          String   @id
  userId      String
  pathId      String
  techniqueId String
  /// Minutes after the credited-minutes ceiling, not as reported.
  minutes     Int
  xp          Int
  /// Kept for the reflections list, never for the XP maths.
  confidence  String
  createdAt   DateTime @default(now())

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  path      LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  technique Technique    @relation(fields: [techniqueId], references: [id], onDelete: Cascade)

  /// The streak and heatmap read by user over time; mastery reads by technique.
  @@index([userId, createdAt])
  @@index([pathId])
  @@index([techniqueId])
}

/// A cleared gate.
///
/// The unique constraint is the whole safety mechanism: clearing a stage is
/// idempotent, so a retried reflect - or a technique completed, un-completed by
/// a bridge insert, and completed again - cannot mint a second badge.
model Badge {
  id       String   @id
  userId   String
  pathId   String
  stage    Int
  label    String
  earnedAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  path LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@unique([pathId, stage])
  @@index([userId, earnedAt])
}
