# Copy to .env and fill in. Never commit .env.

# ---------- API ----------
NODE_ENV=development
PORT=4000

# Postgres (Neon in production)
DATABASE_URL=postgresql://user:password@localhost:5432/reps

# ---------- AI provider ----------
# Which AiProvider implementation to load at startup: groq | gemini
AI_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=

# ---------- Resource provider ----------
# YouTube Data API v3. search.list costs 100 units of a 10,000/day quota,
# so results are cached by normalized query - see the plan doc.
YOUTUBE_API_KEY=

# ---------- Auth ----------
# Google OAuth client used by expo-auth-session; the API verifies the ID token
# and issues its own JWT.
GOOGLE_CLIENT_ID=
JWT_SECRET=

# ---------- Mobile / web client ----------
# Must be EXPO_PUBLIC_ prefixed to be readable in the app bundle.
EXPO_PUBLIC_API_URL=http://localhost:4000
