# Copy to .env and fill in. Never commit .env.

# ---------- API ----------
NODE_ENV=development
PORT=4000

# Postgres (Neon in production). Leave blank to run on in-memory storage,
# which works but loses everything on restart.
DATABASE_URL=postgresql://reps:reps@localhost:5432/reps

# ---------- AI provider ----------
# Which AiProvider implementation to load at startup: groq | gemini | fake.
# With no key set the API falls back to the fake provider, so it always boots.
AI_PROVIDER=groq
GROQ_API_KEY=
# Planner - designs the path. Defaults to openai/gpt-oss-120b
GROQ_MODEL=
# Helper - ranks videos and writes drills. Defaults to openai/gpt-oss-20b.
# A second model on purpose: Groq's rate limits are per model, so opening a
# technique does not compete for tokens with the path that just generated.
GROQ_HELPER_MODEL=
GEMINI_API_KEY=
# Defaults to gemini-2.5-flash
GEMINI_MODEL=
# Defaults to gemini-2.5-flash-lite
GEMINI_HELPER_MODEL=

# ---------- Resource provider ----------
# YouTube Data API v3. search.list costs 100 units of a 10,000/day quota,
# so results are cached by normalized query - see the plan doc.
YOUTUBE_API_KEY=
# Refuse searches past this many units/day, leaving headroom under the 10,000 cap.
YOUTUBE_DAILY_UNIT_BUDGET=8000

# ---------- Auth ----------
# ---------- Optional sign-in ----------
# Sign-in is optional: with these blank the app works fully and simply says
# that cross-device sync is unavailable in this build.
#
# Every OAuth client id that may appear in an ID token's `aud`, comma
# separated. Google issues one per platform and a token minted for any of them
# is legitimate, so all three go here:
#
#   1. console.cloud.google.com -> APIs & Services -> Credentials
#   2. Create OAuth client ID, three times:
#        Web application      -> for the browser build
#        iOS                  -> bundle id in.ozi.reps
#        Android              -> package in.ozi.reps + the signing SHA-1
#   3. Paste all three ids here, and the same ids into
#      apps/mobile/app.json under expo.extra.googleOAuth
#
# The ids are not secrets - they ship in the app bundle. The server still
# verifies every token against this list, so a wrong id fails at the API.
GOOGLE_OAUTH_CLIENT_IDS=

# Signs our own session tokens. Required in production; a dev machine with
# this blank gets a random key per boot, so sessions end at restart rather
# than a default secret reaching a deploy.
SESSION_SECRET=
# Days before the app has to sign in again.
SESSION_DAYS=90

# ---------- Mobile / web client ----------
# Must be EXPO_PUBLIC_ prefixed to be readable in the app bundle.
EXPO_PUBLIC_API_URL=http://localhost:4000
